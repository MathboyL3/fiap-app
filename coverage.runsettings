<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>
            **/Program.cs,
            **/DependencyInjection.cs,
            **/Persistence/Migrations/*.cs,
            **/Persistence/Configurations/*.cs,
            **/Persistence/OficinaDbContextFactory.cs,
            **/obj/**/*.cs
          </ExcludeByFile>
          <Exclude>
            [Oficina.Api]Microsoft.AspNetCore.OpenApi.Generated.*,
            [Oficina.Api]System.Runtime.CompilerServices.*,
            [Oficina.Domain]System.Text.RegularExpressions.Generated.*
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
